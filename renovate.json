{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>datahub-local/datahub-local-core:renovate-presets/default"],
  "includePaths": ["garage/**"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)garage/Chart\\.yaml$/"],
      "matchStrings": ["appVersion: \"(?<currentValue>.*?)\""],
      "depNameTemplate": "dxflrs/garage",
      "datasourceTemplate": "docker"
    }
  ]
}
